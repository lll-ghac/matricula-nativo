# Configuración para Producción
# COPIAR ESTE ARCHIVO COMO .env EN EL SERVIDOR Y CONFIGURAR LOS VALORES REALES

# Puerto del servidor (generalmente 3000 o 5000)
PORT=3000

# Entorno de producción
NODE_ENV=production

# JWT Secret - GENERAR UNA CLAVE MUY SEGURA
# Usar: openssl rand -base64 64
JWT_SECRET=CAMBIAR_ESTE_JWT_SECRET_POR_UNO_MUY_SEGURO_DE_64_CARACTERES

# Configuración de cookies seguras
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# Base de datos (SQLite por defecto)
DATABASE_PATH=./database.db

# CORS Origins permitidos (dominio de producción)
CORS_ORIGIN=https://tu-dominio.com

# Configuración de logging
LOG_LEVEL=info

# Rate limiting (requests por minuto por IP)
RATE_LIMIT_REQUESTS=100

# Configuración de respaldos automáticos
BACKUP_ENABLED=true
BACKUP_HOUR=23
BACKUP_RETENTION_DAYS=30

# Configuración de email (opcional, para futuras funcionalidades)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-email@gmail.com
# SMTP_PASS=tu-password-de-aplicacion