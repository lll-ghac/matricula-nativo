# Configuración de seguridad - NO USAR EN PRODUCCIÓN
JWT_SECRET=tu-secreto-jwt-super-seguro-aqui-cambiame-en-produccion
PORT=5002
NODE_ENV=development

# Base de datos
DB_ENCRYPTION_KEY=clave-de-cifrado-de-base-de-datos-cambiar-en-produccion

# Configuración CORS
FRONTEND_URL=http://localhost:3000

# Configuración de rate limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Configuración de sesión
